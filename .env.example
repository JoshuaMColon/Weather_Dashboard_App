# Weather data needs NO API key: it comes from Open-Meteo through the /api functions.

# Supabase (optional: without these the app runs fully local, with cities in localStorage).
# The publishable/anon key is public by design; Row Level Security protects the data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
